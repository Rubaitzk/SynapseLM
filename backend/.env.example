# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/synapselm

# Security
SECRET_KEY=super-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
# To use a real provider, set LLM_PROVIDER to "openai"
LLM_PROVIDER=mock
# Set your real API key here
LLM_API_KEY=sk-your-api-key-here
# Select your desired model (e.g. gpt-4o, gpt-3.5-turbo)
LLM_MODEL=gpt-4o
