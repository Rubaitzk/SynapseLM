# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/synapselm

# Security
SECRET_KEY=super-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
# To use a real provider, set LLM_PROVIDER to "gemini" or "openai"
LLM_PROVIDER=mock
# Optional fallback system API key (leave empty if exclusively using per-user credentials)
LLM_API_KEY=
# Select your desired model (e.g. gemini-3.6-flash, gpt-4o)
LLM_MODEL=gemini-3.6-flash

# Realtime Pub/Sub & Redis
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Per-User Credential Encryption (AES-GCM 32-byte url-safe base64 string)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here
