# ==============================================================================
# SynapseLM Backend Environment Configuration Template
# All production secrets must be replaced with strong, uniquely generated values.
# NEVER commit production credentials or keys to version control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production

# Server Port (In Railway, automatically provided via $PORT)
PORT=8000

# PostgreSQL Connection String
# Railway internal reference: ${{Postgres.DATABASE_URL}} or postgresql://user:password@postgres.railway.internal:5432/railway
# Note: Both postgres:// and postgresql:// schemes are automatically handled.
DATABASE_URL=postgresql://postgres:password@localhost:5432/synapselm

# JWT Authentication Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-character-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Credential Encryption Key (Fernet symmetric key for encrypting user BYOK API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: This key MUST remain constant across deployments. If lost or changed,
# previously stored user credentials cannot be decrypted.
CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-url-safe-base64-key-here

# Redis Pub/Sub Connection URL
# Railway internal reference: ${{Redis.REDIS_URL}} or redis://default:password@redis.railway.internal:6379
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (comma-separated frontend URLs, no trailing slash, no wildcards in production)
# Example: https://synapselm.vercel.app,https://yourcustomdomain.com
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Default LLM Provider & Model Configuration
# Supported providers: gemini | openai | mock
LLM_PROVIDER=gemini
# Supported gemini models: gemini-3.6-flash, gemini-3.8-flash, gemini-3.8-flash-lite, gemini-3.8-flash-tts
# Supported openai models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=gemini-3.6-flash
# Optional system-wide fallback API key (users can also provide personal keys in Settings)
LLM_API_KEY=
