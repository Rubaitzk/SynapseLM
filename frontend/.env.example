# Frontend Environment Variables (Production & Staging)
# For reverse proxy or same-origin deployments (e.g., NGINX forwarding /api and /ws),
# these can be left empty.
#
# For decoupled deployments (e.g., frontend hosted on Vercel/Netlify/S3 and backend hosted on Fly.io/Render):
# VITE_API_BASE_URL=https://api.synapselm.example.com/api
# VITE_WS_BASE_URL=wss://api.synapselm.example.com

VITE_API_BASE_URL=
VITE_WS_BASE_URL=
