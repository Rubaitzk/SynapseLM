# ==============================================================================
# SynapseLM Frontend Environment Configuration Template (Vercel)
# ==============================================================================
# In Vercel, set these in Project Settings -> Environment Variables.
# Note: VITE_ variables are bundled into the client build and visible to browsers.
# NEVER put secrets, JWT secrets, database URLs, or encryption keys here!

# Production Backend API URL (Must include /api prefix, no trailing slash)
# Example: https://synapselm-production.up.railway.app/api
VITE_API_BASE_URL=https://your-backend-service.up.railway.app/api

# Production Backend WebSocket URL (Must use wss:// scheme, no trailing slash)
# Example: wss://synapselm-production.up.railway.app
VITE_WS_BASE_URL=wss://your-backend-service.up.railway.app
